@model AnatoknightStudios.Models.StaticPage

@{
    ViewBag.Title = "StaticPage";
}


<div class="BlackDiv" style="padding: 30px; border-radius: 20px;">
    <div style="border-radius: 20px; padding: 10px; background-color: whitesmoke; margin: 0;">
        <p>@Model.Title</p>
        <p>@Html.Raw(Model.PageContent)</p>
    </div>
</div>
@Html.ActionLink("Delete", "DeleteStaticPage", new { id = @Model.PageId }, new { @class = "btn btn-danger" })