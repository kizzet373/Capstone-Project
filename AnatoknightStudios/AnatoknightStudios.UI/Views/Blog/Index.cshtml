@model IEnumerable<AnatoknightStudios.Models.Post>

@{
    ViewBag.Title = "Index";
}

<div class="row">
    <div class="col-xs-12">
        @Html.Partial("_DeletePostModal")
    </div>
</div>

<div>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Content</th>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th>Details</th>
                <th>Edit</th>
                <th>Delete</th>
            </tr>
        </thead>

        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.Raw(item.PostContent)
                </td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td>
                    @Html.ActionLink("Details", "Details", new {id = item.PostId}, new {@class = "btn btn-default"})
                </td>
                <td>
                    @Html.ActionLink("Edit", "Edit", new {id = item.PostId}, new {@class = "btn btn-default"})
                </td>
                <td>
                    <button id="btnShowDeletePost" class="btn btn-danger btnShowDeletePost">Delete</button>
                    @Html.Hidden("postId", item.PostId, new {id="postId"})
                    @*@Html.ActionLinkDelete", "_DeletePostModal", new { id = item.PostId }, new { @class = "btn btn-danger", data_toggle = "modal", data_target = "#deletePostModal" })*@
                </td>
            </tr>
        }
    </table>
</div>

<div>
    @Html.ActionLink("Add new Post", "Add", null, new { @class = "btn btn-success" })
</div>

@section scripts{
    <script type="text/javascript" src="~/Scripts/app/deletePost.js"></script>
}