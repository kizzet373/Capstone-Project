
@using AnatoknightStudios.Models
@model AnatoknightStudios.UI.Models.BlogVm
﻿@using AnatoknightStudios.Models

@{
    ViewBag.Title = "AdminBlog";
}

<style>
     .center {
         margin: auto;
         width: 60%;
     }
</style>


<div class="row">
    <div class="col-xs-12">
        @Html.Partial("_DeletePostModal")
    </div>
</div>

<div class="row">
    <div class="col-xs-12">
        @Html.Partial("_AddPostModal", Model.Blog)
    </div>
</div>
<center>
    <div class="BlackDiv" style="padding: 15px; width: 70%;">
        <div class="GrayDiv" style="height: 50px;">
            <table>
                <tr>
                    <td><button type="button" class="btn-primary btn-med" style="margin: 10px;" onclick='location.href = "@Url.Action("AdminBlog", "Blog", null)"'>All Genres</button></td>
                    @foreach (Category category in @Model.Blog.Categories)
                    {
                        <td><button type="button" class="btn-primary btn-med" style="margin: 10px;" onclick='location.href = "@Url.Action("AdminBlog", "Blog", new {categoryId = @category.CategoryId})"'>@category.CategoryName</button></td>
                    }
                </tr>
            </table>
            @*<td><button type="button" class="btn-success btn-med" style="margin: 10px; align-self: center;" onclick='location.href="@Url.Action("AddCategory", "Blog", null)"'>Add Category</button></td>*@
        </div>
    </div>
    <br />

    @if (User.IsInRole("Admin"))
    {
        <div class="BlackDiv" style="border-radius: 10px; padding: 10px 0px; width: 150px; margin: 20px;">
            <button id="btnShowAddPost" class="btn btn-success btnShowAddPost">Add new Post</button>
            @Html.Hidden("BlogId", Model.Blog.BlogId, new { id = "BlogId" })
        </div>
    }
</center>

    <div class="row">

        <div class="BlackDiv col-md-10" style="padding: 30px; border-radius: 20px;">
            <div style="border-radius: 20px; padding: 10px; background-color: whitesmoke;">

                @foreach (var item in Model.Blog.Posts)
                {
                    <div>
                        <div>
                            @if (User.IsInRole("Admin"))
                            {
                                <div class="col-md-2" float left>
                                    @Html.ActionLink("Edit", "EditPost", new {id = item.PostId}, new {@class = "btn btn-success"})
                                    <button id="btnShowDeletePost" class="btn btn-danger btnShowDeletePost">Delete</button>
                                    @Html.Hidden("postId", item.PostId, new {id = "postId"})
                                </div>
                            }
                        </div>

                        <div>
                            <div class="col-md-5" style="text-align: left">
                                <div>
                                    <b> &nbsp;&nbsp; @item.PostDate.ToString("MM-dd-yyyy")</b>
                                </div>
                            </div>
                        </div>
                        <div>
                            <div class="col-md-5" style="text-align: right">
                                <div class="center">
                                    <b>
                                        @item.FirstName
                                        @item.LastName
                                    </b>
                                </div>
                            </div>
                        </div>

                        <div>

                        </div>

                        <div class="center">
                            <b><a href="@Url.Action("PostDetails", "Blog", new {id = item.PostId})" onclick="" type="submit">@item.PostTitle</a></b>
                        </div>
                        <br/>

                        <div class="center">
                            @Html.Raw(item.PostContent)
                        </div>
                    </div>
                    <hr style="height: 1px; border: none; color: #333; background-color: #333;"/>
                }
            </div>
        </div>

        <div class="BlackDiv" style="padding: 10px; border-radius: 25px; position: fixed; right: 0px; top: 50%;">
            <div style="border-radius: 20px; padding: 10px; background-color: whitesmoke; margin: 0;">
                <table>
                    <tr>
                        <strong><td>Tags</td></strong>
                    </tr>
                    @using (Html.BeginForm("ContributorBlog", "Blog", FormMethod.Post, new {@class = "form-group"}))
                    {
                        var tags = Model.Blog.Tags.OrderByDescending(x => x.TagPopularity).Take(10);
                        foreach (Tag tag in tags)
                        {
                            <tr>
                                <td><label><input type="checkbox" onchange="toggleCheckbox(this)"/>@tag.TagName</label></td>
                            </tr>
                        }
                        <tr><td><button class="btn btn-primary" type="submit">Search</button></td></tr>
                    }
                </table>
            </div>
        </div>
        <br />

    </div>

    <br />

    @section scripts{
        <script type="text/javascript" src="~/Scripts/app/deletePost.js"></script>
        <script type="text/javascript" src="~/Scripts/app/addPost.js"></script>
        <script src="~/Scripts/app/addPostValidation.js"></script>
        <script src="~/Scripts/tinymce/tinymce.min.js"></script>
        <script src="~/Scripts/app/tinyMcePage.js"></script>

    }
