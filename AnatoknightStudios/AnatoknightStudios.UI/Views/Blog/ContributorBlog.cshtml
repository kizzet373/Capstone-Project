@using AnatoknightStudios.Models
@using Microsoft.AspNet.Identity
@model AnatoknightStudios.UI.Models.BlogVm

@{
    ViewBag.Title = "ContributorBlog";
    ViewBag.ActiveTags = new List<Tag>();
}

<div class="row">
    <div class="col-xs-12">
        @Html.Partial("_DeletePostModal")
    </div>
</div>

<div class="row">
    <div class="col-xs-12">
        @Html.Partial("_AddPostModal", Model.Blog)
    </div>
</div>


<center>
    <div class="BlackDiv" style="padding: 15px; width: 70%;">
        <div class="GrayDiv" style="height: 50px;">
            <table>
                <tr>
                    <td><button type="button" class="btn-primary btn-med" style="margin: 10px;" onclick='location.href = "@Url.Action("ContributorBlog", "Blog", null)"'>All Games</button></td>
                    @foreach (Category category in @Model.Blog.Categories)
                    {
                        <td><button type="button" class="btn-primary btn-med" style="margin: 10px;" onclick='location.href = "@Url.Action("ContributorBlog", "Blog", new {categoryId = @category.CategoryId})"'>@category.CategoryName</button></td>
                    }
                </tr>
            </table>
            @*<td><button type="button" class="btn-success btn-med" style="margin: 10px; align-self: center;" onclick='location.href="@Url.Action("AddCategory", "Blog", null)"'>Add Category</button></td>*@
        </div>
    </div>
    <br/>

@if (User.IsInRole("Contributor") || User.IsInRole("Admin"))
{
    <div class="BlackDiv" style="border-radius: 10px; padding: 10px 0px; width: 150px; margin: 20px;">
        <button id="btnShowAddPost" class="btn btn-success btnShowAddPost">Add new Post</button>
        @Html.Hidden("BlogId", Model.Blog.BlogId, new {id = "BlogId"})
    </div>
}
</center>

<div class="BlackDiv" style="padding: 30px; border-radius: 20px;">
    <div style="border-radius: 20px; padding: 10px; background-color: whitesmoke; margin: 0;">
        <table class="table" style="background-color: whitesmoke;">          
            <tbody>
            @foreach (var post in Model.Blog.Posts)
            {
                <tr style="border-style: solid; border-width: 2px 2px 2px 2px; border-color: black;">
                    <td style="width: 150px; padding: 0;">

                        @if (User.Identity.GetUserId() == post.AspNetUserId || User.IsInRole("Admin"))
                        {
                            <div style="padding: 8px; border-width: 0 2px 0 0; border-style: solid; height: 95px; background-color: gray">
                                @if (User.Identity.GetUserId() == post.AspNetUserId)
                                {
                                    @Html.ActionLink("Edit", "EditPost", new {id = post.PostId}, new {@class = "btn btn-default btn-sm"})

                                    <button id="btnShowDeletePost" class="btn btn-danger btn-sm btnShowDeletePost">Delete</button>
                                    @Html.Hidden("postId", post.PostId, new {id = "postId"})
                                }

                                <br/>
                                <br/>

                                @if (User.IsInRole("Admin"))
                                {
                                    @Html.ActionLink("Approve", "EditPost", new {id = post.PostId}, new {@class = "btn btn-success btn-sm"})
                                    <button id="btnShowDeletePost" class="btn btn-success btn-sm btnShowDeletePost">revise</button>
                                }
                            </div>
                        }
                        else
                        {
                            <div style="padding: 8px; border-width: 0 2px 0 0; border-style: solid; height: 95px; background-color: black;">
                                <br/>
                                <br/>
                            </div>
                        }
                    </td>
                    <td id="contributorPosts" onclick='location.href = "@Url.Action("PostDetails", "Blog", new {id = @post.PostId})"'>
                        <div>
                            <span>@post.PostDate</span>
                            <div align="right"><b>Published by: @post.FirstName @post.LastName</b></div>
                        </div>                                                
                        <h4 align="center">@post.PostTitle</h4>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
<div class="BlackDiv" style="padding: 10px; border-radius: 25px; position: fixed; right: 0px; top: 50%;">
    <div style="border-radius: 20px; padding: 10px; background-color: whitesmoke; margin: 0;">
        <table>
            <tr>
                <strong><td>Tags</td></strong>
            </tr>
            @using (Html.BeginForm("ContributorBlog", "Blog", FormMethod.Post, new {@class = "form-group"}))
            {
                foreach (Tag tag in @Model.Blog.Tags)
                {
                    <tr>
                        @*@<td>@Html.CheckBoxFor("")</td>*@
                        <td>@tag.TagName</td>
                    </tr>
                }
                <tr><td><button class="btn btn-primary" type="submit">Search</button></td></tr>
            }
        </table>
    </div>
</div>
<br />

@section scripts{
    <script type="text/javascript" src="~/Scripts/app/deletePost.js"></script>
    <script type="text/javascript" src="~/Scripts/app/addPost.js"></script>
    <script src="~/Scripts/tinymce/tinymce.min.js"></script>
    <script src="~/Scripts/app/tinyMcePage.js"></script>
}