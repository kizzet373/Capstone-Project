@using AnatoknightStudios.Models
@model AnatoknightStudios.Models.Blog

@{
    ViewBag.Title = "ContributorBlog";
    ViewBag.ActiveTags = new List<Tag>();
}

<div class="row">
    <div class="col-xs-12">
        @Html.Partial("_DeletePostModal")
    </div>
</div>

<div class="row">
    <div class="col-xs-12">
        @Html.Partial("_AddPostModal")
    </div>
</div>


<center>
    <div class="BlackDiv" style="padding: 30px;">
        <div class="GrayDiv">
            @foreach (Category category in @Model.Categories)
            {
                <span>@category.CategoryName</span>
            }
        </div>
    </div>

    <br/>

    <div>
        @*@Html.ActionLink("Add new Post", "AddPost", new { blogId = Model.BlogId, categoryId = 1 }, new { @class = "btn btn-success" })*@
        <button id="btnShowAddPost" class="btn btn-success btnShowAddPost">Add new Post</button>
        @Html.Hidden("BlogId", Model.BlogId, new {id = "BlogId"})
    </div>
</center>

<div class="BlackDiv" style="padding: 30px; border-radius: 20px;">
    <div style="border-radius: 20px; padding: 10px; background-color: whitesmoke; margin: 0;">
        <table class="table table-striped" style="background-color: whitesmoke;">
            <thead>
            <tr>
                <th>Post Title</th>
                <th>Content</th>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th>Details</th>
                <th>Edit</th>
                <th>Delete</th>
            </tr>
            </thead>

            @foreach (var item in Model.Posts)
            {
                <tr>
                    <td>
                        @item.PostTitle
                    </td>
                    <td>
                        @Html.Raw(item.PostContent)
                    </td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td>
                        @Html.ActionLink("Details", "PostDetails", new {id = item.PostId}, new {@class = "btn btn-default"})
                    </td>
                    <td>
                        @Html.ActionLink("Edit", "EditPost", new {id = item.PostId}, new {@class = "btn btn-default"})
                    </td>
                    <td>
                        <button id="btnShowDeletePost" class="btn btn-danger btnShowDeletePost">Delete</button>
                        @Html.Hidden("postId", item.PostId, new {id = "postId"})
                        @*@Html.ActionLinkDelete", "_DeletePostModal", new { id = item.PostId }, new { @class = "btn btn-danger", data_toggle = "modal", data_target = "#deletePostModal" })*@
                    </td>
                </tr>
            }
        </table>
    </div>
</div>
<div class="BlackDiv, col-md-2" style="padding: 30px; border-radius: 20px;">
    <div style="border-radius: 20px; padding: 10px; background-color: whitesmoke; margin: 0;">
        <table>
            <tr>
                <strong><td>Tags</td></strong>
            </tr>
            @using (Html.BeginForm("ContributorBlog", "Blog", FormMethod.Post, new {@class = "form-group"}))
            {
                foreach (Tag tag in @Model.Tags)
                {
                    <tr>
                        @*@<td>@Html.CheckBoxFor("")</td>*@
                        <td>@tag.TagName</td>
                    </tr>
                }
                <tr><td><button class="btn btn-primary" type="submit">Search</button></td></tr>
            }
        </table>
    </div>
</div>
<br />

@section scripts{
    <script type="text/javascript" src="~/Scripts/app/deletePost.js"></script>
    <script type="text/javascript" src="~/Scripts/app/addPost.js"></script>
    <script src="~/Scripts/tinymce/tinymce.min.js"></script>
    <script src="~/Scripts/app/tinyMcePage.js"></script>
}