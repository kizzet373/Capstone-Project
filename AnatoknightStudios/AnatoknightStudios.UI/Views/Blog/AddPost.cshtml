@model AnatoknightStudios.Models.Post

@{
    ViewBag.Title = "AddPost";
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width"/>

</head>
<body>
<p>
    <h3 style="color: red">Hello there, please enter your blog comment!</h3>
</p>
@using (Html.BeginForm("AddPost", "Blog", null, FormMethod.Post, new { id = "addPost" }))
{
    @Html.AntiForgeryToken()
    
    <div class="form-group">
        <label>Post Title</label>
        @Html.TextBoxFor(m => m.PostTitle, new { @class = "form-control" })
    </div>

    <div>
        @*Need validation for TinyMCE*@
        <textarea id="TinyMcePage" name="PostContent"></textarea>
        <br/>
        <input type="submit" value="Submit" class="btn btn-default"/>
    </div>
}
</body>
</html>

@section scripts {
    <script src="~/Scripts/tinymce/tinymce.min.js"></script>
    <script src="~/Scripts/app/tinyMcePage.js"></script>

    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/app/jquery-validate-defaults.js"></script>
    <script src="~/Scripts/app/addPostValidation.js"></script>
}

